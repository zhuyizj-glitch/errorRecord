# ── 路径与端口 ──

# Obsidian vault 路径（宿主机绝对路径），错题会写入 ${VAULT_PATH}/accounts/{account_id}/{child_id}/{subject}
VAULT_PATH=/Users/your-name/Library/CloudStorage/OneDrive/错题集

# 后端映射到宿主机的端口（容器内固定 8000）
BACKEND_PORT=8001

# 前端开发服务器端口，启动时用 `npm run dev -- --port ${FRONTEND_PORT} --host 0.0.0.0`
FRONTEND_PORT=5173

# ── 访问与安全 ──

# 允许的跨域来源，逗号分隔。手机通过 Tailscale 访问时，把 Mac 的 Tailscale 地址加进来
CORS_ORIGINS=http://localhost:5173,http://100.x.y.z:5173

# 只有在启用 HTTPS 后才改为 true；HTTP 下必须为 false，否则浏览器不会带上会话 Cookie
COOKIE_SECURE=false

# ── IMA 知识库（可选）──

# 关闭时错题只写入本地 vault；开启后 IMA 与本地双写
IMA_ENABLED=false
IMA_API_KEY=
IMA_CLIENT_ID=
IMA_KNOWLEDGE_BASE_ID=
IMA_SYNC_INTERVAL_HOURS=12
